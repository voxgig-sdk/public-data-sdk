      "info": {
        "auth": false,
        "contact": {
          "email": "support@publicdatahub.org",
          "name": "PublicDataHub",
          "url": "https://publicdatahub.org/about"
        },
        "description": "Every response carries the agency, dataset, licence and effective date of the figures it contains. Values are reproduced from official federal releases and are never modelled or estimated; a null is a value the agency did not publish and never means zero.\n\nNo key and no rate limit. `robots.txt` disallows `/api/` for crawl budget, not permission — an on-demand request for one named record is expected and welcome; walking every slug is not. CSV twins of each export (/api/export/hospital/{slug}.csv, /api/export/agency/{slug}.csv, /api/export/school/{slug}.csv, /api/export/district/{slug}.csv) were removed on 2026-10-23: one entity cannot load from both a JSON and a CSV route.",
        "license": {
          "name": "Public domain (17 U.S.C. §105)",
          "url": "https://publicdatahub.org/data/licences"
        },
        "servers": [
          {
            "url": "https://publicdatahub.org"
          }
        ],
